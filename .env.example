OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Max tokens for AI status normalization response (keep low — we only need one word)
OPENROUTER_MAX_TOKENS=20
# Temperature 0 = deterministic output, which is what we want for status classification
OPENROUTER_TEMPERATURE=0

# Maersk official API requires approved access (company email + customer code).
# Set MAERSK_API_ENABLED=true only if you have valid credentials.
# Without credentials the service falls back to public tracking sources.
MAERSK_API_ENABLED=false
MAERSK_API_BASE_URL=https://api.maersk.com
MAERSK_CONSUMER_KEY=
MAERSK_CLIENT_SECRET=

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=3
RETRY_ATTEMPTS=2

DEBUG=false
LOG_LEVEL=INFO
