# OpenRouter — AI fallback for status normalization
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Keep low — we only need one word back from the model
OPENROUTER_MAX_TOKENS=20
# Temperature 0 = deterministic output for classification
OPENROUTER_TEMPERATURE=0

# Maersk official API (optional)
# Requires approved access: https://developer.maersk.com
# Without credentials the service falls back to public tracking sources
MAERSK_API_ENABLED=false
MAERSK_API_BASE_URL=https://api.maersk.com
MAERSK_CONSUMER_KEY=
MAERSK_CLIENT_SECRET=

# Redis
REDIS_URL=redis://localhost:6379/0
# How long to cache tracking results (seconds). Default: 5 minutes
CACHE_TTL_SECONDS=300
# How long to keep last known status for change detection. Default: 7 days
STATUS_TTL_SECONDS=604800

# Request handling
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=3
RETRY_ATTEMPTS=2
# Seconds to wait for JavaScript to render after page load (Playwright)
PLAYWRIGHT_RENDER_WAIT_SECONDS=5

# LangSmith tracing for AI calls (optional)
# Get a free key at https://smith.langchain.com
# Install the package first: uv add langsmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cargo-tracking

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Docker Compose port overrides (optional — uncomment to change)
# API_PORT=8000
# REDIS_PORT=6379
